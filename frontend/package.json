{
  "name": "@ma-store/frontend",
  "version": "1.0.0",
  "private": true,
  "description": "MA STORE - WebApp (React + Vite + TypeScript + PWA)",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "audit:admin": "node ../tests/browser/admin-access.mjs",
    "audit:e2e": "node ../tests/browser/e2e.mjs",
    "audit:responsive": "node ../tests/browser/responsive-audit.mjs",
    "audit:shots": "node ../tests/browser/screenshots.mjs",
    "build": "tsc -b && vite build",
    "build:only": "vite build",
    "dev": "vite",
    "preview": "vite preview --port 4173",
    "serve:test": "node ../tests/browser/local-server.mjs",
    "test": "vitest run",
    "test:ui": "vitest run --reporter=verbose",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^23.10.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
