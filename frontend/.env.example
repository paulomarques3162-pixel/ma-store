# =============================================================================
# MA STORE - Frontend - variaveis de ambiente
# Copie para `.env.local` e ajuste.
#
# ATENCAO: tudo que comeca com VITE_ e EMBUTIDO no bundle e visivel ao
# usuario. NUNCA coloque segredos aqui (chaves de gateway, JWT_SECRET, etc.).
# =============================================================================

# Caminho base da API.
#  - Em desenvolvimento, deixe "/api" para usar o proxy do Vite (sem CORS).
#  - Em producao, aponte para a API publica, ex.:
#    VITE_API_URL=https://api.seudominio.com.br/api
VITE_API_URL=/api

# Nome exibido como fallback quando o CMS ainda nao foi preenchido.
VITE_APP_NAME=MA STORE

# Alvo do proxy de desenvolvimento (usado apenas pelo vite.config.ts).
VITE_PROXY_TARGET=http://127.0.0.1:3333
