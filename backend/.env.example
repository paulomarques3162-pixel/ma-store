# =============================================================================
# MA STORE - Backend - Exemplo de variaveis de ambiente
# Copie para `.env` e preencha. NUNCA comite o arquivo `.env` real.
# =============================================================================

# -----------------------------------------------------------------------------
# Aplicacao
# -----------------------------------------------------------------------------
NODE_ENV=development
# development | test | production
APP_ENV=development
PORT=3333
HOST=0.0.0.0
# Origens permitidas para CORS, separadas por virgula. Use * apenas em dev.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Versao exibida no /api/health (injetada pelo CI/Render)
APP_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Render fornece a connection string pronta. Ex.:
# postgresql://usuario:senha@host:5432/banco?schema=public&sslmode=require
DATABASE_URL=postgresql://mastore:devpassword@127.0.0.1:5432/mastore_dev?schema=public
# Banco usado pela suite de testes (recriado a cada execucao)
TEST_DATABASE_URL=postgresql://mastore:devpassword@127.0.0.1:5432/mastore_test?schema=public
# Prisma usa um banco "shadow" ao rodar `migrate dev`
SHADOW_DATABASE_URL=postgresql://mastore:devpassword@127.0.0.1:5432/mastore_dev?schema=shadow

# -----------------------------------------------------------------------------
# Autenticacao
# -----------------------------------------------------------------------------
# Gere com: openssl rand -hex 32   (minimo 32 caracteres)
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-64-caracteres
JWT_ACCESS_TTL=15m
# Duracao do refresh token / sessao (em dias)
SESSION_TTL_DAYS=30

# -----------------------------------------------------------------------------
# Pagamentos (sandbox x producao)
# -----------------------------------------------------------------------------
# sandbox | production  -> bloqueia uso acidental de credencial de teste em prod
PAYMENT_ENV=sandbox
# Segredo HMAC usado para validar a assinatura dos webhooks do gateway
WEBHOOK_SECRET=troque-este-segredo-de-webhook
# TTL em minutos para expiracao automatica de pagamentos pendentes
PAYMENT_EXPIRES_MINUTES=60
# Credenciais reais do gateway (nunca expostas no frontend)
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# -----------------------------------------------------------------------------
# Frete / Entrega (Guest Checkout)
# -----------------------------------------------------------------------------
# Origem dos calculos de frete (CEP de despacho da loja).
SHIPPING_ORIGIN_CEP=
SHIPPING_FREE_ABOVE=
# Margem fixa de embalagem somada ao peso total, em KG (padrao 0.100 = 100g).
SHIPPING_WEIGHT_MARGIN_KG=0.1

# --- Retirada na loja (gratuita) --------------------------------------------
RETIRADA_ATIVA=true
RETIRADA_NOME=Retirar na loja
RETIRADA_PRAZO=Retirada na loja

# --- Flex / Motoboy (entrega local por faixa de CEP) -------------------------
# So aparece quando o CEP de destino comeca com este prefixo.
# Ex.: Pirassununga/SP usa CEPs 1363x-xxx -> prefixo "1363"
FLEX_CEP_PREFIX=1363
FLEX_VALOR=10
FLEX_PRAZO=Mesmo dia ou até o dia seguinte
FLEX_NOME=Motoboy — Pirassununga

# --- Correios (API oficial de Preco e Prazo) ---------------------------------
# Sem token, a modalidade nao e ofertada. O cliente paga o frete direto aos
# Correios; a loja apenas imprime a etiqueta/nota.
CORREIOS_TOKEN=
CORREIOS_ORIGEM_CEP=
CORREIOS_API_URL=https://api.correios.com.br
CORREIOS_PAC_CODE=04510
CORREIOS_SEDEX_CODE=04014
CORREIOS_CONTRATO=
CORREIOS_DR=

# --- Jetlog ------------------------------------------------------------------
JETLOG_API_URL=
JETLOG_API_TOKEN=
JETLOG_VALOR=
JETLOG_PRAZO=3 a 7 dias úteis
JETLOG_NOME=Jetlog

# --- Pegaki (ponto de retirada) ----------------------------------------------
PEGAKI_API_URL=
PEGAKI_API_TOKEN=
PEGAKI_VALOR=
PEGAKI_PRAZO=3 a 6 dias úteis
PEGAKI_NOME=Ponto de Retirada Pegaki

# -----------------------------------------------------------------------------
# Armazenamento de imagens (uploads)
# -----------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_PUBLIC_URL=http://localhost:3333/uploads

# -----------------------------------------------------------------------------
# E-mail (recuperacao de senha / notificacoes)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
LOG_LEVEL=info
# info | debug | warn | error | silent
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# Limite mais rigoroso para login/cadastro/recuperacao de senha (anti brute-force)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
