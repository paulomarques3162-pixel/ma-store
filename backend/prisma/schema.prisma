// =============================================================================
// MA STORE - Schema Prisma (PostgreSQL)
// -----------------------------------------------------------------------------
// Regra do projeto: NENHUM dado da loja e inventado aqui. O schema apenas
// define a estrutura; todo conteudo real (produtos, precos, contatos, textos,
// PIX, CNPJ...) e cadastrado pelo painel administrativo ou pelo seed marcado
// explicitamente como DEMONSTRACAO/TESTE.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum Role {
  CLIENT
  ADMIN
  DELIVERY_PERSON
}

/// Status da entrega (separado do status do pedido).
enum DeliveryStatus {
  PENDING
  ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

/// Motivo obrigatorio de nao entrega.
enum DeliveryFailureReason {
  CLIENTE_AUSENTE
  ENDERECO_NAO_LOCALIZADO
  RECUSA_DO_RECEBEDOR
  AREA_INACESSIVEL
  PROBLEMA_DE_ACESSO
  OUTRO
}

enum UserStatus {
  ACTIVE
  BLOCKED
  PENDING
}

enum OrderStatus {
  AWAITING_PAYMENT
  PAYMENT_REVIEW
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  MANUAL
}

enum PaymentStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELED
  EXPIRED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum MessageSender {
  CLIENT
  ADMIN
  SYSTEM
}

enum ConversationStatus {
  OPEN
  ARCHIVED
  RESOLVED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FeedbackType {
  PRODUCT
  DELIVERY
  EXPERIENCE
}

enum NotificationType {
  ORDER_CREATED
  PAYMENT_APPROVED
  PAYMENT_DECLINED
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELED
  NEW_MESSAGE
  NEW_FEEDBACK
  LOW_STOCK
  COUPON
  SYSTEM
}

enum TestStatus {
  PASS
  WARN
  FAIL
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  INVALID_SIGNATURE
  FAILED
}

// -----------------------------------------------------------------------------
// Usuarios / autenticacao
// -----------------------------------------------------------------------------

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  phone              String?
  passwordHash       String
  role               Role       @default(CLIENT)
  status             UserStatus @default(ACTIVE)
  // Marca dados de demonstracao para nunca serem confundidos com dados reais.
  isDemo             Boolean    @default(false)
  // Exige troca de senha no proximo login (usado pelo admin de teste do seed).
  mustChangePassword Boolean    @default(false)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  sessions       Session[]
  passwordResets PasswordResetToken[]
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  favorites      Favorite[]
  reviews        Review[]
  feedbacks      Feedback[]
  notifications  Notification[]
  conversations  Conversation[]
  messages       Message[]
  couponUsages   CouponUsage[]
  auditLogs      AdminAuditLog[]
  testRuns       TestRun[]
  statusChanges  OrderStatusHistory[]
  deliveries     Delivery[]

  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String?
  cep        String
  street     String
  number     String
  complement String?
  district   String
  city       String
  state      String
  country    String   @default("BR")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// -----------------------------------------------------------------------------
// Catalogo
// -----------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  position    Int      @default(0)
  active      Boolean  @default(true)
  isDemo      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
  coupons  CouponCategory[]

  @@index([active, position])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  active    Boolean  @default(true)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([active])
  @@map("brands")
}

model Product {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  shortDescription String?
  description      String?
  brandId          String?
  categoryId       String?
  price            Decimal  @db.Decimal(10, 2)
  comparePrice     Decimal? @db.Decimal(10, 2)
  costPrice        Decimal? @db.Decimal(10, 2)
  volume           String?
  weightGrams      Int?
  // Dados logisticos (opcionais) usados pelo Shipping Engine proprio.
  // Peso em gramas e dimensoes em centimetros: unidades explicitas, sem
  // ambiguidade de decimal. Nao ha valor padrao inventado.
  heightCm         Int?
  widthCm          Int?
  lengthCm         Int?
  // Estoque: atual disponivel, reservado (pedido criado, nao pago) e vendido.
  stock            Int      @default(0)
  reservedStock    Int      @default(0)
  soldStock        Int      @default(0)
  minStock         Int      @default(0)
  hasShipping      Boolean  @default(true)
  allowCoupon      Boolean  @default(true)
  isLaunch         Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  isBestSeller     Boolean  @default(false)
  active           Boolean  @default(true)
  isDemo           Boolean  @default(false)
  // Marca PERSISTENTE de que este produto ja gerou o aviso de "novidade" por
  // Web Push. Serve como trava de idempotencia: a notificacao e reivindicada
  // por um UPDATE atomico (`notifiedAt IS NULL` -> `now()`), de modo que
  // duplo clique, retry de requisicao ou duas ativacoes simultaneas nunca
  // disparam mais de um push. `null` = ainda nao notificado.
  notifiedAt       DateTime?
  metaTitle        String?
  metaDescription  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  brand       Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  reviews     Review[]
  favorites   Favorite[]
  coupons     CouponProduct[]

  @@index([active, createdAt])
  @@index([categoryId, active])
  @@index([brandId, active])
  @@index([isFeatured])
  @@index([isLaunch])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int     @default(0)
  // Enquadramento da imagem (CSS object-position). Ex.: "center", "50% 30%".
  focalPoint String @default("center") @map("focal_point") @db.VarChar(30)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

// -----------------------------------------------------------------------------
// Carrinho / favoritos
// -----------------------------------------------------------------------------

model Cart {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// -----------------------------------------------------------------------------
// Cupons
// -----------------------------------------------------------------------------

model Coupon {
  id             String     @id @default(cuid())
  code           String     @unique
  description    String?
  type           CouponType
  value          Decimal    @db.Decimal(10, 2)
  minOrderValue  Decimal?   @db.Decimal(10, 2)
  maxUses        Int?
  maxUsesPerUser Int?
  usesCount      Int        @default(0)
  // Se true aplica em todo o catalogo; caso contrario use products/categories.
  appliesToAll   Boolean    @default(true)
  // Permite que o desconto incida tambem sobre o frete.
  appliesToShipping Boolean @default(false)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean    @default(true)
  isDemo         Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  products   CouponProduct[]
  categories CouponCategory[]
  usages     CouponUsage[]
  orders     Order[]

  @@index([active])
  @@map("coupons")
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_usages")
}

// -----------------------------------------------------------------------------
// Pedidos
// -----------------------------------------------------------------------------

model Order {
  id               String        @id @default(cuid())
  number           String        @unique
  userId           String
  status           OrderStatus   @default(AWAITING_PAYMENT)
  subtotal         Decimal       @db.Decimal(10, 2)
  discount         Decimal       @default(0) @db.Decimal(10, 2)
  shippingCost     Decimal       @default(0) @db.Decimal(10, 2)
  total            Decimal       @db.Decimal(10, 2)
  couponId         String?
  couponCode       String?
  paymentMethod    PaymentMethod?
  // Chave de idempotencia: um duplo clique em "finalizar" nunca cria 2 pedidos.
  idempotencyKey   String?       @unique
  // Snapshot imutavel do endereco no momento da compra.
  shippingAddress  Json
  customerSnapshot Json?
  notes            String?
  isDemo           Boolean       @default(false)
  paidAt           DateTime?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  canceledAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  coupon         Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  shipment       Shipment?
  usages         CouponUsage[]
  conversations  Conversation[]
  reviews        Review[]
  feedbacks      Feedback[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  // Snapshots: o pedido guarda o que foi comprado mesmo se o produto mudar.
  nameSnapshot   String
  skuSnapshot    String
  imageSnapshot  String?
  unitPrice      Decimal @db.Decimal(10, 2)
  quantity       Int
  total          Decimal @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String      @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// -----------------------------------------------------------------------------
// Pagamentos
// -----------------------------------------------------------------------------

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(10, 2)
  provider    String        @default("mock")
  // Referencia externa do gateway (ex.: ID do pagamento no Mercado Pago).
  providerRef String?
  // Nunca armazenamos dados completos de cartao - apenas metadados nao sensiveis.
  metadata    Json?
  approvedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  order    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  @@index([orderId])
  @@index([status])
  @@index([providerRef])
  @@map("payments")
}

model PaymentAttempt {
  id              String        @id @default(cuid())
  paymentId       String
  status          PaymentStatus
  requestPayload  Json?
  responsePayload Json?
  errorCode       String?
  errorMessage    String?
  durationMs      Int?
  createdAt       DateTime      @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model WebhookEvent {
  id             String        @id @default(cuid())
  provider       String
  // Idempotencia: o mesmo evento nunca e processado duas vezes.
  eventId        String
  eventType      String
  payload        Json
  signatureValid Boolean       @default(false)
  status         WebhookStatus @default(RECEIVED)
  errorMessage   String?
  processedAt    DateTime?
  createdAt      DateTime      @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("webhook_events")
}

// -----------------------------------------------------------------------------
// Frete
// -----------------------------------------------------------------------------

model ShippingMethod {
  id          String   @id @default(cuid())
  name        String
  // Codigo estavel da modalidade (ECONOMIC/STANDARD/EXPRESS/SAME_DAY/PICKUP).
  code        String?  @unique @db.VarChar(40)
  description String?
  carrier     String?
  price       Decimal  @db.Decimal(10, 2)
  freeAbove   Decimal? @db.Decimal(10, 2)
  minDays     Int      @default(1)
  maxDays     Int      @default(5)
  // Lista de UFs atendidas. Vazio = todas.
  regions     String[]
  active      Boolean  @default(true)
  position    Int      @default(0)
  // Prioridade no Shipping Engine proprio (maior = exibido/considerado antes).
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipments     Shipment[]
  weightRules   ShippingWeightRule[]
  cepExceptions ShippingCepException[]

  @@index([active, position])
  @@index([active, priority])
  @@map("shipping_methods")
}

model Shipment {
  id               String    @id @default(cuid())
  orderId          String    @unique
  shippingMethodId String?
  carrier          String?
  trackingCode     String?
  status           String    @default("PENDING")
  cost             Decimal   @default(0) @db.Decimal(10, 2)
  shippedAt        DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  @@map("shipments")
}

// -----------------------------------------------------------------------------
// Mensagens / notificacoes
// -----------------------------------------------------------------------------

model Conversation {
  id              String             @id @default(cuid())
  userId          String
  orderId         String?
  subject         String?
  status          ConversationStatus @default(OPEN)
  unreadForAdmin  Int                @default(0)
  unreadForClient Int                @default(0)
  lastMessageAt   DateTime           @default(now())
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([status, lastMessageAt])
  @@index([userId])
  @@index([orderId])
  @@map("conversations")
}

model Message {
  id             String        @id @default(cuid())
  conversationId String
  senderRole     MessageSender
  senderUserId   String?
  authorName     String?
  body           String
  readAt         DateTime?
  createdAt      DateTime      @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

/// Inscrição de Web Push (PWA).
///
/// Anônima de propósito: a loja opera em Guest Checkout, então o consentimento
/// pertence ao NAVEGADOR (endpoint + chaves), não a uma conta de usuário.
model PushSubscription {
  id         String    @id @default(cuid())
  // Endpoint único fornecido pelo serviço de push do navegador.
  endpoint   String    @unique
  // Chaves de criptografia da inscrição (p256dh/auth).
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@map("push_subscriptions")
}

// -----------------------------------------------------------------------------
// Avaliacoes / feedback
// -----------------------------------------------------------------------------

model Review {
  id        String           @id @default(cuid())
  productId String
  userId    String
  orderId   String?
  rating    Int
  title     String?
  comment   String?
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([productId, userId, orderId])
  @@index([productId, status])
  @@index([userId])
  @@index([orderId])
  @@map("reviews")
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String?
  orderId   String?
  productId String?
  type      FeedbackType     @default(EXPERIENCE)
  rating    Int?
  comment   String?
  contact   String?
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())

  user  User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([orderId])
  @@map("feedbacks")
}

// -----------------------------------------------------------------------------
// Conteudo / tema (CMS)
// -----------------------------------------------------------------------------

model Banner {
  id        String    @id @default(cuid())
  title     String?
  subtitle  String?
  imageUrl  String?
  linkUrl   String?
  ctaLabel  String?
  position  String    @default("hero")
  order     Int       @default(0)
  active    Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([position, active, order])
  @@map("banners")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  group     String   @default("geral")
  label     String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([group])
  @@map("site_content")
}

model SiteTheme {
  id          String    @id @default(cuid())
  name        String
  settings    Json
  isDraft     Boolean   @default(true)
  publishedAt DateTime?
  isActive    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive])
  @@map("site_themes")
}

// -----------------------------------------------------------------------------
// Auditoria / laboratorio de testes
// -----------------------------------------------------------------------------

model AdminAuditLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  requestId String?
  createdAt DateTime @default(now())

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("admin_audit_logs")
}

model TestRun {
  id          String   @id @default(cuid())
  suite       String
  status      TestStatus @default(PASS)
  environment String   @default("sandbox")
  requestedBy String?
  durationMs  Int?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?

  results       TestResult[]
  requestedUser User?        @relation(fields: [requestedBy], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@map("test_runs")
}

model TestResult {
  id           String     @id @default(cuid())
  runId        String
  name         String
  category     String
  status       TestStatus
  durationMs   Int        @default(0)
  endpoint     String?
  requestId    String?
  errorMessage String?
  stackTrace   String?
  createdAt    DateTime   @default(now())

  run TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, status])
  @@map("test_results")
}

// -----------------------------------------------------------------------------
// Pedidos Guest Checkout (tabela `pedidos`)
// -----------------------------------------------------------------------------
// Tabela propria do fluxo sem cadastro: o token de rastreio e a unica
// credencial publica. Nao depende de `users` (comprador nao tem conta).

model Pedido {
  id                  Int       @id @default(autoincrement())
  tokenRastreioUnico  String    @unique @map("token_rastreio_unico") @db.VarChar(255)
  clienteNome         String    @map("cliente_nome") @db.VarChar(255)
  clienteWhatsapp     String    @map("cliente_whatsapp") @db.VarChar(50)
  clienteEmail        String?   @map("cliente_email") @db.VarChar(255)
  enderecoCompleto    Json      @map("endereco_completo") @db.JsonB
  produtosCarrinho    Json      @map("produtos_carrinho") @db.JsonB
  freteEscolhidoNome  String?   @map("frete_escolhido_nome") @db.VarChar(255)
  freteEscolhidoValor Decimal?  @map("frete_escolhido_valor") @db.Decimal(10, 2)
  freteEscolhidoPrazo String?   @map("frete_escolhido_prazo") @db.VarChar(255)
  // Transportadora/provedor e servico escolhidos (historico do pedido).
  freteTransportadora String?   @map("frete_transportadora") @db.VarChar(120)
  freteServico        String?   @map("frete_servico") @db.VarChar(160)
  // true => o frete e pago direto a transportadora (ex.: Correios) e NAO entra no total da loja.
  fretePagoDireto     Boolean   @default(false) @map("frete_pago_direto")
  // Snapshot do Shipping Engine proprio: o historico do pedido nao pode
  // depender da regra vigente (que pode mudar depois).
  freteZonaId         String?   @map("frete_zona_id") @db.VarChar(40)
  freteRegraId        String?   @map("frete_regra_id") @db.VarChar(40)
  freteMetodoId       String?   @map("frete_metodo_id") @db.VarChar(40)
  freteMetodoCodigo   String?   @map("frete_metodo_codigo") @db.VarChar(40)
  freteQuoteId        String?   @unique @map("frete_quote_id") @db.VarChar(40)
  fretePrazoDias      Int?      @map("frete_prazo_dias")
  freteEstimado       Boolean   @default(false) @map("frete_estimado")
  fretePrazoMinDias   Int?      @map("frete_prazo_min_dias")
  fretePrazoMaxDias   Int?      @map("frete_prazo_max_dias")
  statusAtual         String    @default("Aguardando Pagamento") @map("status_atual") @db.VarChar(100)
  // Pagamento (PIX estatico / combinado manualmente). NUNCA marcado como pago
  // sem confirmacao real (webhook do provedor ou confirmacao do administrador).
  metodoPagamento     String?   @map("metodo_pagamento") @db.VarChar(30)
  pagamentoStatus     String    @default("Pendente") @map("pagamento_status") @db.VarChar(30)
  pagamentoPayload    String?   @map("pagamento_payload") @db.Text
  pagamentoExpiraEm   DateTime? @map("pagamento_expira_em")
  // --- Gateway externo (Mercado Pago) — campos ADITIVOS ---------------------
  // Nao guardamos dados de cartao: apenas a referencia e o status do provedor.
  pagamentoProvider       String?   @map("pagamento_provider") @db.VarChar(30)
  pagamentoProviderRef    String?   @map("pagamento_provider_ref") @db.VarChar(120)
  pagamentoProviderStatus String?   @map("pagamento_provider_status") @db.VarChar(40)
  // payment_method_id real devolvido pelo gateway (ex.: pix, bolbradesco, visa).
  pagamentoMetodoDetalhe  String?   @map("pagamento_metodo_detalhe") @db.VarChar(60)
  // QR Code PIX em base64 devolvido pelo gateway (quando houver).
  pagamentoQrCodeBase64   String?   @map("pagamento_qr_code_base64") @db.Text
  pagamentoBoletoUrl      String?   @map("pagamento_boleto_url") @db.VarChar(1000)
  pagamentoBoletoBarcode  String?   @map("pagamento_boleto_barcode") @db.VarChar(120)
  // Idempotencia do gateway: uma tentativa nunca gera duas cobrancas.
  pagamentoIdempotencyKey String?   @unique @map("pagamento_idempotency_key") @db.VarChar(120)
  pagoEm                  DateTime? @map("pago_em")
  recebidoPor         String?   @map("recebido_por") @db.VarChar(255)
  dataEntrega         DateTime? @map("data_entrega")
  criadoEm            DateTime  @default(now()) @map("criado_em")

  delivery Delivery?

  @@index([statusAtual])
  @@index([criadoEm])
  @@index([pagamentoProviderRef])
  @@map("pedidos")
}

// -----------------------------------------------------------------------------
// Sequencias internas (numeracao de pedidos)
// -----------------------------------------------------------------------------

model Sequence {
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("sequences")
}

// -----------------------------------------------------------------------------
// Shipping Engine — configuração multi-loja (tabelas ADITIVAS)
// Segredos NÃO ficam aqui: credenciais de provedor vêm de env/secret manager.
// -----------------------------------------------------------------------------

model StoreShippingConfig {
  id                   String   @id @default(cuid())
  storeId              String   @unique @map("store_id")
  originPostalCode     String?  @map("origin_postal_code")
  enabledProviders     String[] @map("enabled_providers")
  enabledServices      Json?
  pricing              Json?
  freeShipping         Json?
  declaredValueEnabled Boolean  @default(true) @map("declared_value_enabled")
  presentationOrder    String[] @map("presentation_order")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@map("store_shipping_configs")
}

model ShippingProviderConfig {
  id          String   @id @default(cuid())
  storeId     String   @map("store_id")
  provider    String
  enabled     Boolean  @default(true)
  environment String   @default("production")
  settings    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([storeId, provider])
  @@index([storeId])
  @@map("shipping_provider_configs")
}

model ShippingRule {
  id        String   @id @default(cuid())
  storeId   String   @map("store_id")
  name      String
  kind      String
  config    Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId, active])
  @@map("shipping_rules")
}

model ShippingQuoteCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique @map("cache_key")
  storeId   String   @map("store_id")
  provider  String
  payload   Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("shipping_quote_cache")
}

// -----------------------------------------------------------------------------
// Shipping Engine PROPRIO (regras locais, sem API oficial dos Correios)
//
// Tabelas ADITIVAS. Nenhum dado comercial e cadastrado automaticamente: o
// administrador cria as zonas/faixas/prazos. Enquanto nao houver configuracao
// suficiente o motor responde SHIPPING_NOT_CONFIGURED (jamais um preco ficticio).
// -----------------------------------------------------------------------------

/// Regiao / faixa de CEP atendida. CEP inicial e final ficam como inteiros
/// (8 digitos) para permitir comparacao de faixa com indice no PostgreSQL.
model ShippingZone {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(300)
  // UF da regiao (opcional, apenas informativo/filtro no admin).
  state       String?  @db.VarChar(2)
  zipCodeFrom Int      @map("zip_code_from")
  zipCodeTo   Int      @map("zip_code_to")
  active      Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  weightRules ShippingWeightRule[]

  @@index([active])
  @@index([zipCodeFrom])
  @@index([zipCodeTo])
  @@index([active, zipCodeFrom, zipCodeTo])
  @@map("shipping_zones")
}

/// Faixa de peso de uma zona com preco e prazo estimados.
model ShippingWeightRule {
  id                         String   @id @default(cuid())
  zoneId                     String   @map("zone_id")
  // Modalidade da regra (zona + modalidade + faixa de peso).
  shippingMethodId           String?  @map("shipping_method_id")
  minWeightGrams             Int      @map("min_weight_grams")
  maxWeightGrams             Int      @map("max_weight_grams")
  price                      Decimal  @db.Decimal(10, 2)
  // Prazo unico da modalidade (dias uteis). Quando ausente, usa-se a faixa estimada.
  deliveryDays               Int?     @map("delivery_days")
  estimatedMinBusinessDays   Int?     @map("estimated_min_business_days")
  estimatedMaxBusinessDays   Int?     @map("estimated_max_business_days")
  priority                   Int      @default(0)
  active                     Boolean  @default(true)
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  zone           ShippingZone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  shippingMethod ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([shippingMethodId])
  @@index([active])
  @@index([zoneId, shippingMethodId, active, minWeightGrams, maxWeightGrams])
  @@map("shipping_weight_rules")
}

/// Configuracoes gerais do motor proprio. Linha unica (id = "default").
/// Valores comerciais (CEP de origem, frete gratis, prazos) sao configurados
/// pelo administrador; nunca ha fallback escondido no codigo.
// -----------------------------------------------------------------------------
// Modulo de entrega / motoboy (ADITIVO)
// -----------------------------------------------------------------------------

/// Entrega de um pedido. Relacionamento 1:1 com `pedidos`; tentativas/reatribuicoes
/// ficam no historico (`delivery_events`).
model Delivery {
  id                     String                 @id @default(cuid())
  pedidoId               Int                    @unique @map("pedido_id")
  driverId               String?                @map("driver_id")
  status                 DeliveryStatus         @default(PENDING)
  assignedAt             DateTime?              @map("assigned_at")
  startedAt              DateTime?              @map("started_at")
  deliveredAt            DateTime?              @map("delivered_at")
  recipientName          String?                @map("recipient_name") @db.VarChar(160)
  recipientDocumentLast4 String?                @map("recipient_document_last4") @db.VarChar(4)
  proofPhotoUrl          String?                @map("proof_photo_url") @db.VarChar(500)
  latitude               Decimal?               @db.Decimal(10, 7)
  longitude              Decimal?               @db.Decimal(10, 7)
  locationAccuracy       Decimal?               @map("location_accuracy") @db.Decimal(10, 2)
  notes                  String?                @db.VarChar(500)
  failureReason          DeliveryFailureReason? @map("failure_reason")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  pedido Pedido         @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  driver User?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  events DeliveryEvent[]

  @@index([driverId, status])
  @@index([status])
  @@index([createdAt])
  @@map("deliveries")
}

/// Historico auditavel de cada mudanca relevante da entrega.
model DeliveryEvent {
  id               String                 @id @default(cuid())
  deliveryId       String                 @map("delivery_id")
  status           DeliveryStatus
  latitude         Decimal?               @db.Decimal(10, 7)
  longitude        Decimal?               @db.Decimal(10, 7)
  locationAccuracy Decimal?               @map("location_accuracy") @db.Decimal(10, 2)
  notes            String?                @db.VarChar(500)
  failureReason    DeliveryFailureReason? @map("failure_reason")
  createdBy        String?                @map("created_by")
  createdAt        DateTime               @default(now()) @map("created_at")

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@map("delivery_events")
}

model ShippingSettings {
  id                            String   @id @default("default")
  enabled                       Boolean  @default(false)
  originZipCode                 String?  @map("origin_zip_code") @db.VarChar(8)
  packagePaddingGrams           Int?     @map("package_padding_grams")
  defaultHandlingDays           Int?     @map("default_handling_days")
  freeShippingEnabled           Boolean  @default(false) @map("free_shipping_enabled")
  freeShippingMinimumOrderValue Decimal? @map("free_shipping_minimum_order_value") @db.Decimal(10, 2)
  // Prazo padrao (dias uteis) usado quando a regra nao define prazo.
  defaultDeliveryDays           Int?     @map("default_delivery_days")
  showEstimateDisclaimer        Boolean  @default(true) @map("show_estimate_disclaimer")
  configVersion                 Int      @default(1) @map("config_version")
  createdAt                     DateTime @default(now()) @map("created_at")
  updatedAt                     DateTime @updatedAt @map("updated_at")

  @@map("shipping_settings")
}

/// Excecao de CEP: sobrescreve preco e/ou prazo de uma modalidade num CEP exato.
model ShippingCepException {
  id                   String   @id @default(cuid())
  cep                  String   @db.VarChar(8)
  shippingMethodId     String   @map("shipping_method_id")
  priceOverride        Decimal? @map("price_override") @db.Decimal(10, 2)
  deliveryDaysOverride Int?     @map("delivery_days_override")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  shippingMethod ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@unique([cep, shippingMethodId])
  @@index([cep])
  @@index([active])
  @@map("shipping_cep_exceptions")
}

/// Cotacao persistida: vinculo de seguranca entre as opcoes exibidas e o pedido.
/// O preco do pedido vem das opcoes gravadas aqui (nunca do frontend).
model ShippingQuote {
  id              String    @id @default(cuid())
  // Sessao opaca do visitante (nao e dado sensivel). Pode ser nula.
  sessionId       String?   @map("session_id") @db.VarChar(120)
  cep             String    @db.VarChar(8)
  subtotal        Decimal   @db.Decimal(10, 2)
  totalWeightGrams Int      @map("total_weight_grams")
  zoneId          String?   @map("zone_id")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  options ShippingQuoteOption[]

  @@index([expiresAt])
  @@index([sessionId])
  @@map("shipping_quotes")
}

model ShippingQuoteOption {
  id               String   @id @default(cuid())
  quoteId          String   @map("quote_id")
  shippingMethodId String   @map("shipping_method_id")
  code             String?  @db.VarChar(40)
  name             String   @db.VarChar(160)
  description      String?  @db.VarChar(300)
  price            Decimal  @db.Decimal(10, 2)
  deliveryDays     Int?     @map("delivery_days")
  zoneId           String?  @map("zone_id")
  ruleId           String?  @map("rule_id")
  createdAt        DateTime @default(now()) @map("created_at")

  quote ShippingQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@index([shippingMethodId])
  @@map("shipping_quote_options")
}
