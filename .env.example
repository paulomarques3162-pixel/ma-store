# =============================================================================
# MA STORE - ambiente de desenvolvimento
# Copie para `.env` na raiz (o docker-compose le este arquivo).
# As MESMAS variaveis sao consumidas pela API em backend/.env
# =============================================================================

# --- Banco de dados (usado pelo container `db` e pela API) --------------------
POSTGRES_USER=mastore
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=mastore_dev
POSTGRES_PORT=5432

# --- Aplicacao ----------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.0.0
PORT=3333
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Dentro do Docker o host do banco e `db`; rodando a API fora do Docker,
# troque `db` por `127.0.0.1`.
DATABASE_URL=postgresql://mastore:devpassword@db:5432/mastore_dev?schema=public
TEST_DATABASE_URL=postgresql://mastore:devpassword@db:5432/mastore_test?schema=public

# --- Autenticacao -------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-64-caracteres
JWT_ACCESS_TTL=15m
SESSION_TTL_DAYS=30

# --- Pagamentos ---------------------------------------------------------------
PAYMENT_ENV=sandbox
WEBHOOK_SECRET=troque-este-segredo-de-webhook
PAYMENT_EXPIRES_MINUTES=60
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# --- Frete / armazenamento / e-mail ------------------------------------------
SHIPPING_ORIGIN_CEP=
SHIPPING_FREE_ABOVE=
SHIPPING_WEIGHT_MARGIN_KG=0.1
# Retirada na loja (gratuita)
RETIRADA_ATIVA=true
RETIRADA_NOME=Retirar na loja
RETIRADA_PRAZO=Retirada na loja
# Motoboy / Flex local (prefixo do CEP da cidade da loja)
FLEX_CEP_PREFIX=1363
FLEX_VALOR=10
FLEX_PRAZO=Mesmo dia ou até o dia seguinte
FLEX_NOME=Motoboy — Pirassununga
# Correios (Preco e Prazo) - cliente paga direto aos Correios
CORREIOS_TOKEN=
CORREIOS_ORIGEM_CEP=
CORREIOS_API_URL=https://api.correios.com.br
CORREIOS_PAC_CODE=04510
CORREIOS_SEDEX_CODE=04014
CORREIOS_CONTRATO=
CORREIOS_DR=
# Jetlog
JETLOG_API_URL=
JETLOG_API_TOKEN=
JETLOG_VALOR=
JETLOG_PRAZO=3 a 7 dias úteis
JETLOG_NOME=Jetlog
# Pegaki (ponto de retirada)
PEGAKI_API_URL=
PEGAKI_API_TOKEN=
PEGAKI_VALOR=
PEGAKI_PRAZO=3 a 6 dias úteis
PEGAKI_NOME=Ponto de Retirada Pegaki
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_PUBLIC_URL=http://localhost:3333/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Observabilidade e limites -----------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Seed (dados de DEMONSTRACAO) --------------------------------------------
SEED_ADMIN_EMAIL=admin@teste.local
SEED_ADMIN_PASSWORD=Teste@Admin123
