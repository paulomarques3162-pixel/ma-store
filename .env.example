# =============================================================================
# MA STORE - ambiente de desenvolvimento
# Copie para `.env` na raiz (o docker-compose le este arquivo).
# As MESMAS variaveis sao consumidas pela API em backend/.env
# =============================================================================

# --- Banco de dados (usado pelo container `db` e pela API) --------------------
POSTGRES_USER=mastore
POSTGRES_PASSWORD=devpassword
POSTGRES_DB=mastore_dev
POSTGRES_PORT=5432

# --- Aplicacao ----------------------------------------------------------------
NODE_ENV=development
APP_ENV=development
APP_VERSION=1.0.0
PORT=3333
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Dentro do Docker o host do banco e `db`; rodando a API fora do Docker,
# troque `db` por `127.0.0.1`.
DATABASE_URL=postgresql://mastore:devpassword@db:5432/mastore_dev?schema=public
TEST_DATABASE_URL=postgresql://mastore:devpassword@db:5432/mastore_test?schema=public

# --- Autenticacao -------------------------------------------------------------
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-de-64-caracteres
JWT_ACCESS_TTL=15m
SESSION_TTL_DAYS=30

# --- Pagamentos ---------------------------------------------------------------
PAYMENT_ENV=sandbox
WEBHOOK_SECRET=troque-este-segredo-de-webhook
PAYMENT_EXPIRES_MINUTES=60
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# --- Frete / armazenamento / e-mail ------------------------------------------
SHIPPING_ORIGIN_CEP=
SHIPPING_FREE_ABOVE=
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_PUBLIC_URL=http://localhost:3333/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- Observabilidade e limites -----------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Seed (dados de DEMONSTRACAO) --------------------------------------------
SEED_ADMIN_EMAIL=admin@teste.local
SEED_ADMIN_PASSWORD=Teste@Admin123
