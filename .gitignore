# .gitignore — MA STORE
# Nunca comite segredos nem artefatos de build.

# Dependências
node_modules/
.pnp/
.pnp.js

# Build
dist/
build/
.next/
out/

# Ambiente — NUNCA comitar
.env
.env.local
.env.*.local
.env.production
*.env

# Prisma
prisma/*.db
prisma/*.db-journal

# Uploads locais
var/
uploads/
!.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Testes e cobertura
coverage/
.nyc_output/
test-results/
playwright-report/

# Editores e SO
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Cache
.cache/
.turbo/
.eslintcache
tsconfig.tsbuildinfo
.neon

# Cache TypeScript
tsconfig.*.tsbuildinfo
